# /etc/orbit/orbit.env  — owned by orbit:orbit, chmod 640.
# Keys stay server-side; the browser never sees them.

# Legacy defaults without /opt/orbit/collection.profile.
# Production: deploy_release.py --demo-250 selects the existing Demo key,
# 250 assets / 300s markets / 3600s global, overriding these non-secret settings.
# It never copies keys into the profile. See RUNBOOK.md.

# Universe size and sparkline depth
ORBIT_TOP=500
ORBIT_SPARK_TOP=250
ORBIT_LOGO_FETCH_PER_RUN=60
# Cache crypto pages between timer ticks; no extra provider call from visitors.
ORBIT_MARKETS_REFRESH_SEC=60
ORBIT_GLOBAL_REFRESH_SEC=120
ORBIT_SOCIAL_REFRESH_SEC=900
ORBIT_MACRO_REFRESH_SEC=3600

# CoinGecko: none (public) | demo | pro
CG_API_TIER=none
CG_API_KEY=

# Optional premium sources (leave empty to disable)
LUNARCRUSH_API_KEY=
FRED_API_KEY=

# Output (must match the Apache Alias targets)
ORBIT_OUT_DIR=/var/lib/orbit
ORBIT_LOGO_DIR=/var/lib/orbit/logos
